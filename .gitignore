# Only the two CTRL projects and repository documentation belong here.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/ctrl/
!/ctrl-demo-video/

# Private runtime configuration and generated output
**/node_modules/
**/.env*
!**/.env.example
**/.dev.vars*
**/.ctrl-data/
**/.vercel/
**/.openai/
**/.agents/
**/.codex/
**/.wrangler/
**/.sites-runtime/
**/.next/
**/dist/
**/website-dist/
**/.website-previews/
**/website-previews/
**/out/
**/.remotion/
**/coverage/
**/__pycache__/
*.key
*.pem
*.keystore
*.p12
*.log
*.tsbuildinfo
*.pyc
/ctrl/api/*.mjs

# Keep video reproduction inputs and the final presentation deliverables.
!/ctrl-demo-video/out/
/ctrl-demo-video/out/*
!/ctrl-demo-video/out/voice-words.json
!/ctrl-demo-video/out/timeline.json
!/ctrl-demo-video/out/elevenlabs-generation.json
!/ctrl-demo-video/out/quality-check.json
!/ctrl-demo-video/out/CTRL-demo-final.mp4
!/ctrl-demo-video/out/CTRL-demo-en.srt
!/ctrl-demo-video/out/CTRL-thumbnail.png
!/ctrl-demo-video/out/POST_COPY.md
